# ---- Portale ----
LISTEN_ADDR=:8080
# URL pubblico del portale (usato per i redirect OAuth: deve combaciare con quello
# registrato su Google/Microsoft; HTTPS obbligatorio per i provider, tranne localhost)
PUBLIC_URL=https://vpn.example.com
# Secret per firmare i cookie di sessione (stringa casuale lunga)
SESSION_SECRET=cambiami-con-una-stringa-casuale-lunga

# ---- OAuth (almeno un provider) ----
# Google: https://console.cloud.google.com/apis/credentials -> OAuth Client ID (Web)
#   Redirect URI da registrare: $PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID: https://portal.azure.com -> App registrations
#   Redirect URI da registrare: $PUBLIC_URL/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# Limita chi puo' accedere (vuoti = tutti gli account autenticati!)
ALLOWED_DOMAINS=dottormarc.it
ALLOWED_EMAILS=

# ---- MikroTik REST API ----
# Dal container su RouterOS usare l'IP del gateway della veth (es. http://172.18.0.1)
MIKROTIK_URL=http://172.18.0.1
# Consigliato un utente dedicato con policy: read, write, api, rest-api
MIKROTIK_USER=wg-portal
MIKROTIK_PASS=
# true per HTTPS con certificato self-signed
MIKROTIK_INSECURE=false

# ---- WireGuard ----
# Interfaccia WireGuard sul router a cui aggiungere i peer
WG_INTERFACE=wg-portal
# Endpoint pubblico che i client useranno (host o host:porta; senza porta usa la listen-port dell'interfaccia)
WG_ENDPOINT=vpn.example.com
# Subnet da cui assegnare gli IP dei client (.1 riservato al router)
WG_SUBNET=10.99.99.0/24
# DNS suggerito ai client (vuoto = nessuno)
WG_DNS=192.168.1.1
# Cosa instradare nel tunnel lato client (0.0.0.0/0 = tutto)
WG_ALLOWED_IPS=192.168.1.0/24
# Durata del profilo: es. 30m, 8h, 7d — alla scadenza il peer viene rimosso dal router
WG_TTL=8h
# Ogni quanto controllare i peer scaduti
CLEANUP_INTERVAL=60s

# ---- Solo per sviluppo/test: login finto senza OAuth (NON usare in produzione) ----
#DEV_FAKE_AUTH=test@example.com
