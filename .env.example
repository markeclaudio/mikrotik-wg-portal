# ---- Portal ----
LISTEN_ADDR=:8080
# Public URL of the portal (used for OAuth redirects: must match the one
# registered on Google/Microsoft; HTTPS is required by the providers, except localhost)
PUBLIC_URL=https://vpn.example.com
# Secret used to sign session cookies (long random string)
SESSION_SECRET=change-me-with-a-long-random-string

# ---- Automatic HTTPS (ACME / Let's Encrypt) ----
# Set ACME_DOMAIN to enable a built-in HTTPS listener with an automatic
# Let's Encrypt certificate (TLS-ALPN-01 challenge). Requirements:
#   - ACME_DOMAIN resolves to your public IP (MikroTik cloud DDNS works:
#     /ip/cloud set ddns-enabled=yes -> xxxxxxxx.sn.mynetname.net)
#   - public port 443 reaches LISTEN_TLS (on RouterOS: dst-nat 443 -> container:8443)
#   - ACME_CACHE should be persistent (a volume/mount) or the certificate is
#     re-issued at every restart (Let's Encrypt rate limits apply!)
# The certificate renews automatically. PUBLIC_URL should then be https://$ACME_DOMAIN
ACME_DOMAIN=
ACME_EMAIL=admin@example.com
ACME_CACHE=/acme
LISTEN_TLS=:8443

# ---- Cloudflare dynamic DNS (optional) ----
# Keeps an A record of your own Cloudflare-managed domain pointed at the
# current public IP (checked every CF_INTERVAL), so you can use e.g.
# vpn.example.com instead of the MikroTik mynetname.net name.
# Create the token at https://dash.cloudflare.com/profile/api-tokens with
# permission "Zone / DNS / Edit" (+ Zone/Read) on the zone.
# The record is kept DNS-only (grey cloud): the Cloudflare proxy would break
# both the WireGuard endpoint (UDP) and the TLS-ALPN certificate issuance.
# When using this, set ACME_DOMAIN/PUBLIC_URL/WG_ENDPOINT to the same name.
CF_API_TOKEN=
CF_RECORD=vpn.example.com
# Zone name; empty = auto-detected from CF_RECORD
CF_ZONE=
CF_INTERVAL=5m
CF_PROXIED=false

# ---- OAuth (at least one provider) ----
# Step-by-step guide to obtain all these values: docs/oauth-setup.md
# Google: https://console.cloud.google.com/apis/credentials -> OAuth Client ID (Web)
#   Redirect URI to register: $PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID: https://portal.azure.com -> App registrations
#   Redirect URI to register: $PUBLIC_URL/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# Restrict who can log in (empty = every authenticated account!)
ALLOWED_DOMAINS=example.com
ALLOWED_EMAILS=

# ---- MikroTik REST API ----
# From a RouterOS container use the veth gateway IP (e.g. http://172.18.0.1)
MIKROTIK_URL=http://172.18.0.1
# A dedicated user with policies read, write, api, rest-api is recommended
MIKROTIK_USER=wg-portal
MIKROTIK_PASS=
# true for HTTPS with a self-signed certificate
MIKROTIK_INSECURE=false

# ---- WireGuard ----
# WireGuard interface on the router where peers are added
WG_INTERFACE=wg-portal
# Public endpoint clients will use (host or host:port; without port the interface listen-port is used)
WG_ENDPOINT=vpn.example.com
# Subnet client IPs are allocated from (.1 is reserved for the router)
WG_SUBNET=10.99.99.0/24
# DNS pushed to clients (empty = none)
WG_DNS=192.168.1.1
# What to route through the tunnel on the client side (0.0.0.0/0 = everything)
WG_ALLOWED_IPS=192.168.1.0/24
# Profile lifetime: e.g. 30m, 8h, 7d — when it expires the peer is removed from the router
WG_TTL=8h
# How often to check for expired peers
CLEANUP_INTERVAL=60s
